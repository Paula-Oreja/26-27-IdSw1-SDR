
@startuml
title Plataforma Alumni UNEATLANTICO - Modelo del Dominio - Iteracion 3

left to right direction
hide empty members

skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false

package "Comunidad universitaria" {

    class Universidad
    class Alumni
    class Titulacion
    class Promocion
    class PerfilProfesional
    class Formacion
    class Certificacion
    class Idioma
    class InteresProfesional
    class Pais

}

package "Ambito social" {

    class ComunidadAlumni
    class Evento
    class ParticipacionEvento
    class ResponsableAlumni
    class ContactoAlumni

}

package "Ambito laboral" {

    class Empresa
    class OfertaEmpleo
    class Candidatura
    class Curriculum
    class ExperienciaLaboral
    class Contratacion
    class SeguimientoEmpresa

}

package "Servicios Alumni" {

    class Servicio
    class Suscripcion

}

package "Gestion universitaria" {

    class Administrador
    class SolicitudEmpresa
    class RevisionOferta
    class Incidencia
    class AutorizacionDatos

}

' ==========================================
' COMUNIDAD UNIVERSITARIA
' ==========================================

Universidad "1" -- "0..*" Titulacion : ofrece

Universidad "1" -- "0..*" Alumni : comunidad de

Alumni "0..*" -- "1..*" Titulacion : ha cursado

Alumni "0..*" -- "0..*" Promocion : pertenece a

Alumni "0..*" -- "1" Pais : reside en

Alumni "1" *-- "0..1" PerfilProfesional : dispone de

PerfilProfesional "1" -- "0..*" Formacion : incluye

PerfilProfesional "1" -- "0..*" Certificacion : incluye

PerfilProfesional "1" -- "0..*" Idioma : acredita

PerfilProfesional "0..*" -- "0..*" InteresProfesional : tiene

PerfilProfesional "1" -- "0..*" ExperienciaLaboral : recoge

ExperienciaLaboral "0..*" --> "0..1" Empresa : desarrollada en

' ==========================================
' SERVICIOS
' ==========================================

Alumni "1" -- "0..*" Suscripcion : realiza

Servicio "1" -- "0..*" Suscripcion : corresponde a

Universidad "1" -- "0..*" Servicio : ofrece

' ==========================================
' AMBITO SOCIAL
' ==========================================

ComunidadAlumni "0..*" -- "0..*" Alumni : agrupa

ComunidadAlumni "0..*" -- "0..1" Titulacion : asociada a

ComunidadAlumni "0..*" -- "0..1" Promocion : asociada a

ComunidadAlumni "0..*" -- "0..1" Pais : asociada a

Universidad "1" -- "0..*" Evento : promueve

ComunidadAlumni "0..1" -- "0..*" Evento : organiza actividades

Alumni "1" -- "0..*" ParticipacionEvento : participa mediante

Evento "1" -- "0..*" ParticipacionEvento : registra

Alumni <|-- ResponsableAlumni

ResponsableAlumni "0..*" -- "0..*" Evento : organiza

Universidad "1" -- "0..*" ResponsableAlumni : designa

Alumni "1" -- "0..*" ContactoAlumni : solicita

ContactoAlumni "0..*" -- "1" Alumni : destinatario

' ==========================================
' AMBITO LABORAL
' ==========================================

Empresa "1" -- "0..*" OfertaEmpleo : propone

OfertaEmpleo "0..*" -- "0..*" InteresProfesional : relacionada con

Alumni "1" -- "0..*" Candidatura : presenta

OfertaEmpleo "1" -- "0..*" Candidatura : recibe

Alumni "1" -- "0..*" Curriculum : dispone de

Candidatura "0..*" --> "0..1" Curriculum : incorpora

Candidatura "1" -- "0..1" Contratacion : puede originar

Empresa "1" -- "0..*" Contratacion : realiza

Alumni "1" -- "0..*" Contratacion : es contratado

Alumni "0..*" -- "0..*" Empresa : sigue

Alumni "0..*" -- "0..*" Empresa : esta vinculado a

Empresa "1" -- "0..*" SeguimientoEmpresa : registra resultados

' ==========================================
' GESTION UNIVERSITARIA
' ==========================================

Universidad "1" -- "0..*" Administrador : cuenta con

Empresa "1" -- "1" SolicitudEmpresa : solicita incorporacion

Administrador "0..1" -- "0..*" SolicitudEmpresa : revisa

OfertaEmpleo "1" -- "0..*" RevisionOferta : pasa por

Administrador "1" -- "0..*" RevisionOferta : realiza

Administrador "0..1" -- "0..*" Incidencia : registra

Incidencia "0..*" -- "1" Alumni : afecta a

Alumni "1" -- "0..*" AutorizacionDatos : concede

AutorizacionDatos "0..*" -- "1" Empresa : autoriza comunicacion a

AutorizacionDatos "0..*" -- "0..1" Candidatura : asociada a

@enduml


