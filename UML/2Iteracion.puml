@startuml
title Plataforma Alumni UNEATLANTICO - Modelo del Dominio

top to bottom direction
hide empty members

skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam shadowing false
skinparam nodesep 55
skinparam ranksep 75

' CLASES PRINCIPALES

class Universidad
class Alumni
class Empresa

' SEGUNDO NIVEL

class Titulacion
class PerfilProfesional
class ComunidadAlumni
class Evento
class OfertaEmpleo
class Administrador

' TERCER NIVEL

class Curriculum
class ExperienciaLaboral
class Candidatura
class Contratacion

' RELACIONES UNIVERSIDAD

Universidad -- Titulacion : ofrece
Universidad -- Administrador : cuenta con

Alumni -- Titulacion : ha cursado

' RELACIONES ALUMNI

Alumni -- PerfilProfesional : dispone de
Alumni -- ComunidadAlumni : pertenece a
Alumni -- Evento : participa en

' PERFIL PROFESIONAL

PerfilProfesional -- ExperienciaLaboral : incluye
Alumni -- Curriculum : dispone de

' PARTE SOCIAL

ComunidadAlumni -- Evento : organiza

' PARTE LABORAL

Empresa -- OfertaEmpleo : propone
Alumni -- Candidatura : presenta
OfertaEmpleo -- Candidatura : recibe
Candidatura -- Contratacion : puede originar

' GESTION UNIVERSITARIA

Administrador -- OfertaEmpleo : revisa

' ORGANIZACION VISUAL

Universidad -[hidden]right- Alumni
Alumni -[hidden]right- Empresa

Titulacion -[hidden]right- PerfilProfesional
PerfilProfesional -[hidden]right- ComunidadAlumni
ComunidadAlumni -[hidden]right- Evento
Evento -[hidden]right- OfertaEmpleo

Curriculum -[hidden]right- ExperienciaLaboral
ExperienciaLaboral -[hidden]right- Candidatura
Candidatura -[hidden]right- Contratacion

@enduml

